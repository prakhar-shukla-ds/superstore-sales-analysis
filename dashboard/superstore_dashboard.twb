            <column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Regional bar]' derivation='User' name='[usr:Regional bar:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.superstore].[none:In reporting period:nk]'>
            <groupfilter function='member' level='[none:In reporting period:nk]' member='true' />
          </filter>
          <filter class='categorical' column='[federated.superstore].[none:Region:nk]'>
            <groupfilter function='member' level='[none:Region:nk]' member='&quot;Central&quot;' />
          </filter>
          <slices>
            <column>[federated.superstore].[none:In reporting period:nk]</column>
            <column>[federated.superstore].[none:Region:nk]</column>
          </slices>
          <aggregation value='true' />
