    <worksheet name='Region Central'>
      <table>
        <view>
          <datasources>
            <datasource caption='Superstore · Orders, People &amp; Returns' name='federated.superstore' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Jan — Dec 2026' caption='Reporting period' datatype='integer' name='[Reporting Year]' param-domain-type='list' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='All years · 2023–2026' />
                <alias key='2023' value='Jan — Dec 2023' />
                <alias key='2024' value='Jan — Dec 2024' />
                <alias key='2025' value='Jan — Dec 2025' />
                <alias key='2026' value='Jan — Dec 2026' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.superstore'>
            <column caption='Bar track' datatype='integer' name='[Bar track]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='In reporting period' datatype='boolean' name='[In reporting period]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Reporting Year] = 0 OR YEAR([Order Date]) = [Parameters].[Reporting Year]' />
            </column>
            <column caption='Largest region in period' datatype='real' name='[Largest region in period]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : MAX([Regional sales in period]) }' />
            </column>
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column caption='Regional bar' datatype='real' name='[Regional bar]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Sales]) / MIN([Largest region in period]) * 0.90' />
            </column>
            <column caption='Regional sales in period' datatype='real' name='[Regional sales in period]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Region] : SUM(IF [In reporting period] THEN [Sales] END) }' />
            </column>
            <column datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Sales]' role='measure' type='quantitative' />
            <column-instance column='[Bar track]' derivation='Min' name='[min:Bar track:qk]' pivot='key' type='quantitative' />
