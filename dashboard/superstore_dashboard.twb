            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Regional bar]' derivation='User' name='[usr:Regional bar:qk]' pivot='key' type='quantitative' />
