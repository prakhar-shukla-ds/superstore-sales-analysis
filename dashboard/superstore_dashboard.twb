    <worksheet name='Customers | top 10'>
      <table>
        <view>
          <datasources>
            <datasource caption='Superstore · Orders, People &amp; Returns' name='federated.superstore' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Jan — Dec 2026' caption='Reporting period' datatype='integer' name='[Reporting Year]' param-domain-type='list' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
              <aliases>
                <alias key='0' value='All years · 2023–2026' />
                <alias key='2023' value='Jan — Dec 2023' />
                <alias key='2024' value='Jan — Dec 2024' />
                <alias key='2025' value='Jan — Dec 2025' />
                <alias key='2026' value='Jan — Dec 2026' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.superstore'>
            <column datatype='string' name='[Customer ID]' role='dimension' type='nominal' />
            <column datatype='string' name='[Customer Name]' role='dimension' type='nominal' />
            <column caption='Customer sales in period' datatype='real' default-format='c&quot;$&quot;#,##0' name='[Customer sales in period]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Customer ID] : SUM(IF [In reporting period] THEN [Sales] ELSE 0 END) }' />
            </column>
            <column caption='Customer' datatype='string' name='[Customer]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Customer Name] + &quot; · &quot; + [Customer ID]' />
            </column>
            <column caption='In reporting period' datatype='boolean' name='[In reporting period]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Reporting Year] = 0 OR YEAR([Order Date]) = [Parameters].[Reporting Year]' />
            </column>
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Order ID]' role='dimension' type='nominal' />
            <column datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Profit]' role='measure' type='quantitative' />
            <column datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Sales]' role='measure' type='quantitative' />
            <column caption='Total orders' datatype='integer' default-format='n#,##0' name='[Total orders]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([Order ID])' />
            </column>
            <column-instance column='[Customer sales in period]' derivation='Min' name='[min:Customer sales in period:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Customer]' derivation='None' name='[none:Customer:nk]' pivot='key' type='nominal' />
            <column-instance column='[In reporting period]' derivation='None' name='[none:In reporting period:nk]' pivot='key' type='nominal' />
            <column-instance column='[Profit]' derivation='Sum' name='[sum:Profit:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Total orders]' derivation='User' name='[usr:Total orders:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.superstore].[:Measure Names]'>
            <groupfilter function='union'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.superstore].[sum:Sales:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.superstore].[usr:Total orders:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.superstore].[sum:Profit:qk]&quot;' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.superstore].[:Measure Names]' direction='ASC'>
            <dictionary>
              <bucket>&quot;[federated.superstore].[sum:Sales:qk]&quot;</bucket>
              <bucket>&quot;[federated.superstore].[usr:Total orders:qk]&quot;</bucket>
              <bucket>&quot;[federated.superstore].[sum:Profit:qk]&quot;</bucket>
            </dictionary>
          </manual-sort>
          <filter class='categorical' column='[federated.superstore].[none:Customer:nk]'>
            <groupfilter count='10' end='top' function='end' units='records'>
              <groupfilter direction='DESC' expression='MIN([Customer sales in period])' function='order'>
                <groupfilter function='level-members' level='[none:Customer:nk]' />
              </groupfilter>
            </groupfilter>
          </filter>
          <computed-sort column='[federated.superstore].[none:Customer:nk]' direction='DESC' using='[federated.superstore].[min:Customer sales in period:qk]' />
          <filter class='categorical' column='[federated.superstore].[none:In reporting period:nk]'>
            <groupfilter function='member' level='[none:In reporting period:nk]' member='true' />
          </filter>
          <slices>
            <column>[federated.superstore].[:Measure Names]</column>
            <column>[federated.superstore].[none:Customer:nk]</column>
            <column>[federated.superstore].[none:In reporting period:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
