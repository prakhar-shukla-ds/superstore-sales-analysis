      </column>
      <column caption='Bar track' datatype='integer' name='[Bar track]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column datatype='string' name='[Category]' role='dimension' type='nominal' />
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Customer count' datatype='integer' default-format='n#,##0' name='[Customer count]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Customer ID])' />
      </column>
      <column caption='Customer orders in period' datatype='integer' name='[Customer orders in period]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [Customer ID] : COUNTD(IF [In reporting period] THEN [Order ID] END) }' />
      </column>
      <column caption='Customer sales in period' datatype='real' default-format='c&quot;$&quot;#,##0' name='[Customer sales in period]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Customer ID] : SUM(IF [In reporting period] THEN [Sales] ELSE 0 END) }' />
      </column>
      <column caption='Customer' datatype='string' name='[Customer]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Customer Name] + &quot; · &quot; + [Customer ID]' />
      </column>
      <column datatype='real' default-format='p0.0%' name='[Discount]' role='measure' type='quantitative' />
      <column caption='Donut axis' datatype='integer' name='[Donut axis]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='In reporting period' datatype='boolean' name='[In reporting period]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Reporting Year] = 0 OR YEAR([Order Date]) = [Parameters].[Reporting Year]' />
      </column>
      <column caption='Largest customer sales' datatype='real' default-format='c&quot;$&quot;#,##0' name='[Largest customer sales]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MAX([Customer sales in period]) }' />
      </column>
      <column caption='Largest region in period' datatype='real' name='[Largest region in period]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MAX([Regional sales in period]) }' />
      </column>
      <column caption='Manager and region' datatype='string' name='[Manager and region]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Regional Manager] + &quot; · &quot; + [Region]' />
      </column>
      <column caption='Month number' datatype='integer' name='[Month number]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&quot;month&quot;, [Order Date])' />
      </column>
      <column caption='Order return rate' datatype='real' default-format='p0.0%' name='[Order return rate]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Returned orders] / COUNTD([Order ID])' />
      </column>
      <column caption='People Region' datatype='string' name='[People Region]' role='dimension' type='nominal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Postal Code]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
      <column caption='Profit display' datatype='string' name='[Profit display]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &lt; 0 THEN &quot;−$&quot; + STR(ROUND(ABS(SUM([Profit]))/1000,0)) + &quot;K&quot; ELSE &quot;$&quot; + STR(ROUND(SUM([Profit])/1000,0)) + &quot;K&quot; END' />
      </column>
      <column caption='Profit margin' datatype='real' default-format='p0.0%' name='[Profit margin]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Profit]' role='measure' type='quantitative' />
      <column datatype='string' name='[Region]' role='dimension' type='nominal' />
      <column caption='Regional Manager' datatype='string' name='[Regional Manager]' role='dimension' type='nominal' />
      <column caption='Regional bar' datatype='real' name='[Regional bar]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / MIN([Largest region in period]) * 0.90' />
      </column>
      <column caption='Regional label' datatype='string' name='[Regional label]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;$&quot; + STR(ROUND(SUM([Sales])/1000,0)) + &quot;K&quot;' />
      </column>
      <column caption='Regional sales in period' datatype='real' name='[Regional sales in period]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Region] : SUM(IF [In reporting period] THEN [Sales] END) }' />
      </column>
      <column caption='Returned Order ID' datatype='string' name='[Returned Order ID]' role='dimension' type='nominal' />
      <column caption='Returned orders' datatype='integer' default-format='n#,##0' name='[Returned orders]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Returned] = &quot;Yes&quot; THEN [Order ID] END)' />
      </column>
      <column caption='Returned sales display' datatype='string' name='[Returned sales display]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;$&quot; + STR(ROUND([Returned sales]/1000,0)) + &quot;K&quot;' />
      </column>
      <column caption='Returned sales' datatype='real' default-format='c&quot;$&quot;#,##0' name='[Returned sales]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Returned] = &quot;Yes&quot; THEN [Sales] ELSE 0 END)' />
      </column>
      <column caption='Returned' datatype='string' name='[Returned]' role='dimension' type='nominal' />
      <column caption='Revenue line' datatype='real' name='[Revenue line]' role='measure' type='quantitative'>
