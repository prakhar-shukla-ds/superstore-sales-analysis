      </column>
      <column datatype='integer' name='[Row ID]' role='dimension' type='ordinal' />
      <column caption='Sales display' datatype='string' name='[Sales display]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ABS(SUM([Sales])) &gt;= 1000000 THEN &quot;$&quot; + STR(ROUND(SUM([Sales])/1000000,2)) + &quot;M&quot; ELSE &quot;$&quot; + STR(ROUND(SUM([Sales])/1000,0)) + &quot;K&quot; END' />
      </column>
      <column caption='Sales mix' datatype='real' default-format='p0.0%' name='[Sales mix]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / TOTAL(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sales per customer' datatype='real' default-format='c&quot;$&quot;#,##0' name='[Sales per customer]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([Customer ID])' />
      </column>
      <column datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Sales]' role='measure' type='quantitative' />
      <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
      <column caption='Top customer name' datatype='string' name='[Top customer name]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MIN(IF [Customer sales in period] = [Largest customer sales] THEN [Customer Name] END)' />
      </column>
      <column caption='Top customer sales' datatype='real' default-format='c&quot;$&quot;#,##0' name='[Top customer sales]' role='measure' type='quantitative'>
